%% -*- mode: erlang;erlang-indent-level: 4;indent-tabs-mode: nil -*-

{minimum_otp_vsn, "27"}.
{erl_opts, [debug_info]}.

%% Nova by git until 1.0.0 is on Hex.
{deps, [
        {nova, {git, "https://github.com/novaframework/nova.git", {branch, "feat/1.0"}}},
        {roadrunner, "0.16.2"}
       ]}.

%% `elp eqwalize-all` reads this profile (see .elp.toml): eqwalizer_support
%% holds the specs eqWAlizer needs for OTP's generic functions.
{profiles, [
            {eqwalizer, [
                {deps, [
                    {eqwalizer_support,
                        {git_subdir, "https://github.com/WhatsApp/erlang-language-platform.git",
                            {tag, "2026-08-07"}, "eqwalizer/eqwalizer_support"}}
                ]}
            ]}
           ]}.

{project_plugins, [
    rebar3_ex_doc,
    {rebar3_audit, {git, "https://github.com/Taure/rebar3_audit.git", {branch, "main"}}},
    {rebar3_sbom,
        {git, "https://github.com/Taure/rebar3_sbom.git", {branch, "feat/include-otp-components"}}},
    covertool
]}.

{xref_checks, [undefined_function_calls, undefined_functions]}.

{dialyzer, [{warnings, [error_handling, unmatched_returns, unknown]},
            {plt_apps, all_deps},
            {plt_extra_apps, [ssl, public_key]}]}.

{ex_doc, [{proglang, erlang},
          {main, <<"readme">>},
          {extras, [<<"README.md">>]},
          {source_url, <<"https://github.com/novaframework/nova_roadrunner">>},
          {homepage_url, <<"https://novaframework.org">>}
         ]}.

{hex, [{doc, #{provider => ex_doc}}]}.
